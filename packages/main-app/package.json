{
	"name": "main-app",
	"version": "0.0.1",
	"description": "主应用",
	"dependencies": {
		"@ice/stark": "^2.8.4",
		"@zxkws/shared-fetch": "workspace:*",
		"antd": "^5.20.2",
		"history": "^5.3.0",
		"styled-components": "^6.1.19"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@iceworks/spec": "^1.6.0",
		"@tailwindcss/postcss": "^4.1.17",
		"autoprefixer": "^10.4.21",
		"css-loader": "^7.1.2",
		"mini-css-extract-plugin": "^2.9.4",
		"postcss": "^8.5.6",
		"postcss-loader": "^8.2.0",
		"tailwindcss": "^4.1.17",
		"webpack-bundle-analyzer": "^5.1.0",
		"workbox-webpack-plugin": "^7.4.0"
	},
	"scripts": {
		"dev": "webpack serve -c ./config/webpack.config.js --mode development",
		"dev:prod": "SERVER_ENV=prod webpack serve -c ./config/webpack.config.js --mode development",
		"build": "API_BASE_URL=https://system.zxkws.nyc.mn/api NODE_ENV=production webpack -c ./config/webpack.config.js --mode=production",
		"lint": "npm run biome:check && npm run stylelint",
