{
  "name": "zxkws.github.io",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf node_modules packages/**/node_modules packages/**/**/node_modules pnpm-lock.yaml .ice packages/**/.ice",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -n \"main,v-app,auth,pdf,textdiff,config,confighub,vue-learn,react-learn,knowledge,resume,codex\" -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold,bgRed.bold,bgGreen.bold,bgCyan.bold,bgYellow.bold,bgBlue.bold,bgMagenta.bold,bgBlue.bold,bgBlack.bold,bgGreen.bold\" \"pnpm dev:main\" \"pnpm dev:v-app\" \"pnpm dev:auth\" \"pnpm dev:pdf-editor\" \"pnpm dev:textdiff\" \"pnpm dev:config\" \"pnpm dev:config-hub\" \"pnpm dev:vue-learning\" \"pnpm dev:react-learning\" \"pnpm dev:knowledge-hub\" \"pnpm dev:resume\" \"pnpm dev:codex-chat\"",
    "dev:main": "pnpm --filter main-app dev",
    "dev:v-app": "pnpm --filter v-app vite",
    "dev:auth": "pnpm --filter auth-app dev",
    "dev:textdiff": "pnpm --filter textdifference dev",
    "dev:config": "pnpm --filter config-center dev",
    "dev:config-hub": "pnpm --filter config-hub dev",
    "dev:pdf-editor": "pnpm --filter pdf-editor-app dev",
    "dev:resume": "pnpm --filter person-resume-app dev",
    "build:pdf-editor": "pnpm --filter pdf-editor-app build",
    "preview:pdf-editor": "pnpm --filter pdf-editor-app preview",
    "start:pdf-editor": "pnpm --filter pdf-editor-app start",
    "dev:vue-learning": "pnpm --filter vue-learning-app dev",
    "dev:react-learning": "pnpm --filter react-learning-app dev",
    "dev:knowledge-hub": "pnpm --filter knowledge-hub-app dev",
    "dev:codex-chat": "pnpm --filter codex-chat-app dev",
    "build": "pnpm run build:all",
    "build:all": "pnpm --filter main-app build && pnpm --filter v-app build && pnpm --filter auth-app build && pnpm --filter textdifference build && pnpm --filter config-center build && pnpm --filter config-hub build && pnpm --filter pdf-editor-app build && pnpm --filter person-resume-app build && pnpm --filter vue-learning-app build && pnpm --filter react-learning-app build && pnpm --filter knowledge-hub-app build",
    "postinstall": "pnpm i @google/gemini-cli @anthropic-ai/claude-code -g || true",
    "prepare": "husky"
  },
  "imports": {
    "#*": "./*"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@rollup/plugin-commonjs": "^28.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "stylelint": "^16.25.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "axios": "^1.12.2",
    "less": "^4.4.2",
    "path-to-regexp": "^8.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "url-parse": "^1.5.10"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-vue": "^6.0.1",
      "autoprefixer": "^10.4.21",
      "postcss": "^8.5.6",
      "tailwindcss": "^4.1.17"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm exec eslint --cache --fix",
      "pnpm exec prettier --write"
    ],
    "*.{json,md,css,scss,vue}": "pnpm exec prettier --write"
  }
}
